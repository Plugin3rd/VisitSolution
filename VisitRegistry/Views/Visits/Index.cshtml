@model IEnumerable<VisitRegistry.Models.Visit>
@using VisitRegistry.Services
@inject PersianDateService PersianDate
@{
    ViewData["Title"] = "سوابق مراجعات";
}
<div class="page-head">
    <div class="page-title">
        <span class="page-title-icon" aria-hidden="true"><svg><use href="#i-history"></use></svg></span>
        <div>
            <h1>سوابق مراجعات</h1>
            <p class="subtitle">تاریخچه ورود و خروج ثبت‌شده در سامانه</p>
        </div>
    </div>
    <a class="button" asp-action="Create"><svg aria-hidden="true"><use href="#i-plus"></use></svg> ثبت مراجعه</a>
</div>

@await Html.PartialAsync("_SearchBar", "نام، نام خانوادگی، شماره ملی، واحد فعالیت یا واحد مراجعه")

<div class="card flush">
    <div class="table-toolbar">
        <span class="count js-row-count"></span>
        <div class="search-field table-search js-table-search">
            <svg class="search-icon" aria-hidden="true"><use href="#i-search"></use></svg>
            <input type="search" placeholder="فیلتر سریع در همین صفحه" aria-label="فیلتر سریع جدول" autocomplete="off" />
            <button type="button" class="clear-search" aria-label="پاک کردن فیلتر">
                <svg style="width:14px;height:14px" aria-hidden="true"><use href="#i-x"></use></svg>
            </button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="responsive-table" data-table>
<thead>
            <tr>
                <th class="sortable">شخص</th>
                <th>شماره ملی</th>
                <th class="sortable">تاریخ ورود</th>
                <th>ساعت ورود</th>
                <th>واحد فعالیت</th>
                <th>واحد مراجعه‌کننده</th>
                <th>ساعت خروج</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td data-label="شخص">@item.Person.FirstName @item.Person.LastName</td>
                    <td data-label="شماره ملی"><span class="mono">@item.Person.NationalCode</span></td>
                    <td data-label="تاریخ ورود"><span class="mono">@PersianDate.ToPersianDigitsDate(item.EntryDate)</span></td>
                    <td data-label="ساعت ورود"><span class="mono">@PersianDate.ToPersianTime(item.EntryTime)</span></td>
                    <td data-label="واحد فعالیت">@(item.Person.OrganizationalUnit?.Title ?? "—")</td>
                    <td data-label="واحد مراجعه‌کننده">@(item.VisitingUnit?.Title ?? "—")</td>
                        <td data-label="ساعت خروج">
                            @if (item.ExitTime.HasValue)
                            {
                                <span class="mono">@PersianDate.ToPersianTime(item.ExitTime.Value)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td data-label="وضعیت">
                            @if (item.IsOpen)
                            {
                                <span class="badge success">حاضر</span>
                            }
                            else
                            {
                                <span class="badge neutral">خارج شده</span>
                            }
                        </td>
                        <td class="actions" data-label="عملیات">
                            @if (item.IsOpen && (User.IsInRole("مدیر سامانه") || User.IsInRole("اپراتور")))
                            {
                                <a class="button small secondary" asp-action="Exit" asp-route-id="@item.VisitId">ثبت خروج</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
                <tr data-empty-row hidden>
                    <td colspan="8">
                        <partial name="_EmptyState" model="@("مراجعه‌ای یافت نشد. عبارت جستجو را تغییر دهید یا مراجعه جدیدی ثبت کنید.")" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <partial name="_TablePager" />
</div>
