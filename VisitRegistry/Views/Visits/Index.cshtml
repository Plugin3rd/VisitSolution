@model IEnumerable<VisitRegistry.Models.Visit>
@inject VisitRegistry.Services.PersianDateService PersianDate
@{
    ViewData["Title"] = "سوابق مراجعات";
}
<div class="page-head"><h1>سوابق مراجعات</h1><a class="button" asp-action="Create">ثبت مراجعه</a></div>
<form method="get" class="searchbar"><input name="search" value="@Context.Request.Query["search"]" placeholder="نام، نام خانوادگی یا شماره ملی" /><button class="button secondary">جستجو</button></form>
<div class="card table-wrap"><table class="responsive-table"><thead><tr><th>شخص</th><th>شماره ملی</th><th>تاریخ ورود</th><th>ورود</th><th>واحد مراجعه‌کننده</th><th>خروج</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td data-label="شخص">@item.Person.FirstName @item.Person.LastName</td><td data-label="شماره ملی">@item.Person.NationalCode</td><td data-label="تاریخ ورود">@PersianDate.ToPersian(item.EntryDate)</td><td data-label="ورود">@item.EntryTime.ToString(@"hh\:mm")</td><td data-label="واحد مراجعه‌کننده">@item.VisitingUnit.Title</td><td data-label="خروج">@(item.ExitTime.HasValue ? item.ExitTime.Value.ToString(@"hh\:mm") : "-")</td><td data-label="وضعیت">@(item.IsOpen ? "حاضر" : "خارج شده")</td><td data-label="عملیات">@if(item.IsOpen && (User.IsInRole("مدیر سامانه") || User.IsInRole("اپراتور"))){<a asp-action="Exit" asp-route-id="@item.VisitId">ثبت خروج</a>}</td></tr>
}
</tbody></table></div>
