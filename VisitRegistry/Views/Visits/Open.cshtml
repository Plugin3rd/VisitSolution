@model IEnumerable<VisitRegistry.Models.Visit>
@{
    ViewData["Title"] = "افراد حاضر";
}
<div class="page-head"><h1>افراد حاضر در مجموعه</h1><a class="button" asp-action="Create">ثبت مراجعه</a></div>
<div class="card table-wrap"><table class="responsive-table"><thead><tr><th>شخص</th><th>شماره ملی</th><th>واحد مراجعه‌کننده</th><th>ساعت ورود</th><th>توضیحات</th><th>عملیات</th></tr></thead><tbody>
@foreach (var item in Model){<tr><td data-label="شخص">@item.Person.FirstName @item.Person.LastName</td><td data-label="شماره ملی">@item.Person.NationalCode</td><td data-label="واحد مراجعه‌کننده">@item.VisitingUnit.Title</td><td data-label="ساعت ورود">@item.EntryTime.ToString(@"hh\:mm")</td><td data-label="توضیحات">@item.EntryDescription</td><td data-label="عملیات"><a asp-action="Exit" asp-route-id="@item.VisitId">ثبت خروج</a></td></tr>}
</tbody></table></div>
