@model VisitRegistry.ViewModels.VisitEntryViewModel
@using VisitRegistry.Services
@inject PersianDateService PersianDate
@{
    ViewData["Title"] = "ثبت مراجعه";
    var units = (IEnumerable<VisitRegistry.Models.OrganizationalUnit>)ViewBag.Units;
}
<div class="page-head">
    <div class="page-title">
        <span class="page-title-icon" aria-hidden="true"><svg><use href="#i-login"></use></svg></span>
        <div>
            <h1>ثبت ورود مراجعه‌کننده</h1>
            <p class="subtitle">شناسایی شخص و ثبت ساعت ورود به مجموعه</p>
        </div>
    </div>
    <a asp-action="Index">بازگشت به سوابق</a>
</div>

<div class="card form-grid two visit-entry-card">
    <div class="card-head">
        <h2>اطلاعات مراجعه</h2>
        <span class="chip">@PersianDate.ToPersianLong(DateTime.Now)</span>
    </div>

    <form asp-action="Create" method="post" id="visit-entry-form" class="visit-entry-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation validation-summary-errors span-2"></div>

        <div class="visit-field">
            <label for="person-search">شخص <span class="req">*</span></label>
            <div class="person-picker" id="person-picker"
                 data-person-picker
                 data-endpoint="@Url.Action("SearchPersons", "Visits")"
                 data-form-id="visit-entry-form"
                 data-help-id="person-help">
                <input type="text"
                       id="person-search"
                       class="person-search-input"
                       autocomplete="off"
                       placeholder="نام، نام خانوادگی، شماره ملی یا موبایل را وارد کنید..."
                       aria-label="جستجوی شخص" />
                <input asp-for="PersonId" type="hidden" />
                <div id="person-selected" class="person-selected" hidden></div>
                <div id="person-search-results" class="person-search-results" role="listbox" hidden></div>
            </div>
            <span id="person-help" class="field-help">حداقل ۲ حرف یا رقم وارد کنید. با کلیدهای جهت‌دار می‌توانید در نتایج جابجا شوید.</span>
            <span asp-validation-for="PersonId" class="validation"></span>
        </div>

        <div class="visit-field">
            <label asp-for="VisitingUnitId">واحد مراجعه‌کننده <span class="req">*</span></label>
            <select asp-for="VisitingUnitId">
                <option value="">انتخاب واحد</option>
                @foreach (var u in units)
                {
                    <option value="@u.OrganizationalUnitId">@u.Title</option>
                }
            </select>
            <span asp-validation-for="VisitingUnitId" class="validation"></span>
        </div>

        <div class="visit-field visit-time-field">
            <label asp-for="EntryTime">ساعت ورود <span class="req">*</span></label>
            <div class="field-with-btn">
                <input asp-for="EntryTime" type="text" class="time-input" data-time-picker autocomplete="off" aria-describedby="entry-time-help" />
                <button type="button" class="field-btn" aria-label="انتخاب ساعت ورود">
                    <svg aria-hidden="true"><use href="#i-clock"></use></svg>
                </button>
            </div>
            <span id="entry-time-help" class="field-help">ساعت را از انتخابگر یا به‌صورت ۲۴ ساعته مانند ۰۸:۳۰ وارد کنید.</span>
            <span asp-validation-for="EntryTime" class="validation"></span>
        </div>

        <div class="visit-field">
            <label asp-for="EntryDescription">توضیحات ورود</label>
            <textarea asp-for="EntryDescription" placeholder="در صورت نیاز، توضیحی از مراجعه ثبت کنید..."></textarea>
        </div>

        <div class="form-actions span-2">
            <button class="button" type="submit"><svg aria-hidden="true"><use href="#i-check"></use></svg> ثبت ورود</button>
            <a class="button ghost" asp-action="Open">انصراف</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/person-picker.js" asp-append-version="true"></script>
}
