@model VisitRegistry.ViewModels.VisitExitViewModel
@using VisitRegistry.Services
@inject PersianDateService PersianDate
@{
    ViewData["Title"] = "ثبت خروج";
}
<div class="page-head">
    <div class="page-title">
        <span class="page-title-icon" aria-hidden="true"><svg><use href="#i-logout"></use></svg></span>
        <div>
            <h1>ثبت خروج</h1>
            <p class="subtitle">تکمیل مراجعه و ثبت ساعت خروج از مجموعه</p>
        </div>
    </div>
    <a asp-action="Open">بازگشت به افراد حاضر</a>
</div>

<div class="card form-grid two">
    <div class="card-head">
        <h2>مراجعه‌کننده</h2>
        <span class="chip"><svg style="width:14px;height:14px" aria-hidden="true"><use href="#i-calendar"></use></svg> @PersianDate.ToPersianLong(DateTime.Now)</span>
    </div>

    <p class="span-2">شخص: <strong>@ViewBag.PersonName</strong></p>

    <form asp-action="Exit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VisitId" />
        <div asp-validation-summary="All" class="validation validation-summary-errors"></div>

        <div class="span-2">
            <label asp-for="ExitTime">ساعت خروج <span class="req">*</span></label>
            <div class="field-with-btn">
                <input asp-for="ExitTime" type="text" class="time-input" data-time-picker autocomplete="off" aria-describedby="exit-time-help" />
                <button type="button" class="field-btn" aria-label="انتخاب ساعت خروج">
                    <svg aria-hidden="true"><use href="#i-clock"></use></svg>
                </button>
            </div>
            <span id="exit-time-help" class="field-help">ساعت را از انتخابگر یا به‌صورت ۲۴ ساعته مانند ۱۷:۱۵ وارد کنید.</span>
            <span asp-validation-for="ExitTime" class="validation"></span>
        </div>

        <div class="span-2">
            <label asp-for="ExitDescription">توضیحات خروج</label>
            <textarea asp-for="ExitDescription" placeholder="در صورت نیاز، توضیحی از خروج ثبت کنید..."></textarea>
        </div>

        <div class="form-actions span-2">
            <button class="button" type="submit"><svg aria-hidden="true"><use href="#i-check"></use></svg> ثبت خروج</button>
            <a class="button ghost" asp-action="Open">انصراف</a>
        </div>
    </form>
</div>
