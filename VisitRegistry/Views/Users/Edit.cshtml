@model VisitRegistry.ViewModels.UserEditViewModel
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "ویرایش کاربر";
    var roles = (IEnumerable<IdentityRole>)ViewBag.Roles;
}
<div class="page-head">
    <div class="page-title">
        <span class="page-title-icon" aria-hidden="true"><svg><use href="#i-edit"></use></svg></span>
        <div>
            <h1>ویرایش کاربر</h1>
            <p class="subtitle">اصلاح اطلاعات حساب و سطح دسترسی</p>
        </div>
    </div>
    <a asp-action="Index">بازگشت به فهرست</a>
</div>

<div class="card form-grid two">
    <div class="card-head">
        <h2>اطلاعات حساب</h2>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation validation-summary-errors"></div>

        <div>
            <label asp-for="UserName">نام کاربری <span class="req">*</span></label>
            <input asp-for="UserName" autocomplete="off" />
            <span asp-validation-for="UserName" class="validation"></span>
        </div>

        <div>
            <label asp-for="DisplayName">نام نمایشی <span class="req">*</span></label>
            <input asp-for="DisplayName" autocomplete="name" />
            <span asp-validation-for="DisplayName" class="validation"></span>
        </div>

        <div class="span-2">
            <label asp-for="Password">رمز عبور جدید</label>
            <input asp-for="Password" autocomplete="new-password" placeholder="در صورت نیاز وارد کنید" />
            <span class="field-help">اگر خالی بماند، رمز عبور فعلی تغییر نمی‌کند.</span>
            <span asp-validation-for="Password" class="validation"></span>
        </div>

        <div class="span-2">
            <label asp-for="Role">نقش <span class="req">*</span></label>
            <select asp-for="Role">
                <option value="">انتخاب نقش</option>
                @foreach (var r in roles)
                {
                    <option value="@r.Name">@r.Name</option>
                }
            </select>
            <span asp-validation-for="Role" class="validation"></span>
        </div>

        <div class="span-2">
            <label class="check"><input asp-for="IsActive" /> فعال باشد</label>
        </div>

        <div class="form-actions span-2">
            <button class="button" type="submit"><svg aria-hidden="true"><use href="#i-check"></use></svg> ذخیره تغییرات</button>
            <a class="button ghost" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
