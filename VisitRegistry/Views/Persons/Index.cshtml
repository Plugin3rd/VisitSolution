@model IEnumerable<VisitRegistry.Models.Person>
@{ ViewData["Title"] = "اشخاص"; }
<div class="page-head"><h1>فهرست اشخاص</h1>@if(User.IsInRole("مدیر سامانه") || User.IsInRole("اپراتور")){<a class="button" asp-action="Create">شخص جدید</a>}</div>
<form method="get" class="searchbar"><input name="search" value="@Context.Request.Query["search"]" placeholder="نام، نام خانوادگی، شماره ملی یا موبایل" /><button class="button secondary">جستجو</button></form>
<div class="card table-wrap"><table class="responsive-table"><thead><tr><th>نام</th><th>نام خانوادگی</th><th>شماره ملی</th><th>موبایل</th><th>واحد</th><th>وضعیت</th>@if(User.IsInRole("مدیر سامانه") || User.IsInRole("اپراتور")){<th>عملیات</th>}</tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td data-label="نام">@item.FirstName</td><td data-label="نام خانوادگی">@item.LastName</td><td data-label="شماره ملی">@item.NationalCode</td><td data-label="موبایل">@item.Mobile</td><td data-label="واحد">@item.OrganizationalUnit?.Title</td><td data-label="وضعیت">@(item.IsActive ? "فعال" : "غیرفعال")</td>
@if(User.IsInRole("مدیر سامانه") || User.IsInRole("اپراتور")){<td class="actions" data-label="عملیات"><a class="button small secondary" asp-action="Edit" asp-route-id="@item.PersonId">ویرایش</a>@if(User.IsInRole("مدیر سامانه")){<form asp-action="Delete" asp-route-id="@item.PersonId" method="post" class="inline" onsubmit="return confirm('آیا از حذف این شخص مطمئن هستید؟');">@Html.AntiForgeryToken()<button type="submit" class="button small danger">حذف</button></form>}</td>}
</tr>
}
</tbody></table></div>
