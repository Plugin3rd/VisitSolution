@model IEnumerable<VisitRegistry.Models.Person>
@{
    ViewData["Title"] = "اشخاص";
}
<div class="page-head"><h1>فهرست اشخاص</h1><a class="button" asp-action="Create">شخص جدید</a></div>
<form method="get" class="searchbar"><input name="search" value="@Context.Request.Query["search"]" placeholder="نام، نام خانوادگی، شماره ملی یا موبایل" /><button class="button secondary">جستجو</button></form>
<div class="card table-wrap"><table><thead><tr><th>نام</th><th>نام خانوادگی</th><th>شماره ملی</th><th>موبایل</th><th>واحد</th><th>وضعیت</th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td>@item.FirstName</td><td>@item.LastName</td><td>@item.NationalCode</td><td>@item.Mobile</td><td>@item.OrganizationalUnit.Title</td><td>@(item.IsActive ? "فعال" : "غیرفعال")</td></tr>
}
</tbody></table></div>
