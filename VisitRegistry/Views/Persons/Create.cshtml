@model VisitRegistry.Models.Person
@{
    ViewData["Title"] = "ثبت شخص جدید";
    var units = (IEnumerable<VisitRegistry.Models.OrganizationalUnit>)ViewBag.Units;
}
<div class="page-head">
    <div class="page-title">
        <span class="page-title-icon" aria-hidden="true"><svg><use href="#i-user-plus"></use></svg></span>
        <div>
            <h1>ثبت شخص جدید</h1>
            <p class="subtitle">افزودن مراجعه‌کننده جدید به فهرست اشخاص</p>
        </div>
    </div>
    <a asp-action="Index">بازگشت به فهرست</a>
</div>

<div class="card form-grid two">
    <div class="card-head">
        <h2>اطلاعات فردی</h2>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation validation-summary-errors"></div>

        <div>
            <label asp-for="FirstName">نام <span class="req">*</span></label>
            <input asp-for="FirstName" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="validation"></span>
        </div>

        <div>
            <label asp-for="LastName">نام خانوادگی <span class="req">*</span></label>
            <input asp-for="LastName" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="validation"></span>
        </div>

        <div>
            <label asp-for="NationalCode">شماره ملی <span class="req">*</span></label>
            <input asp-for="NationalCode" inputmode="numeric" maxlength="10" placeholder="۰۰۱۲۳۴۵۶۷۸" class="mono" autocomplete="off" />
            <span asp-validation-for="NationalCode" class="validation"></span>
        </div>

        <div>
            <label asp-for="Mobile">موبایل <span class="req">*</span></label>
            <input asp-for="Mobile" inputmode="tel" maxlength="11" placeholder="۰۹۱۲۳۴۵۶۷۸۹" class="mono" autocomplete="off" />
            <span asp-validation-for="Mobile" class="validation"></span>
        </div>

        <div class="span-2">
            <label asp-for="OrganizationalUnitId">واحد فعالیت <span class="req">*</span></label>
            <select asp-for="OrganizationalUnitId">
                <option value="0">انتخاب کنید</option>
                @foreach (var u in units)
                {
                    <option value="@u.OrganizationalUnitId">@u.Title</option>
                }
            </select>
            <span asp-validation-for="OrganizationalUnitId" class="validation"></span>
        </div>

        <div class="span-2">
            <label class="check"><input asp-for="IsActive" /> فعال باشد</label>
        </div>

        <div class="form-actions span-2">
            <button class="button" type="submit"><svg aria-hidden="true"><use href="#i-check"></use></svg> ثبت اطلاعات</button>
            <a class="button ghost" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
