@{ ViewData["Title"] = "خطا"; }
<div class="card">
    <div class="state-page">
        <div class="state-icon danger" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><path d="M12 8v5" /><path d="M12 16h.01" />
            </svg>
        </div>
        <h1>خطایی رخ داده است</h1>
        <p>در پردازش درخواست مشکلی رخ داده است. لطفاً دوباره تلاش کنید یا در صورت تکرار مشکل با مدیر سامانه تماس بگیرید.</p>
        <div class="actions" style="justify-content:center">
            <a class="button" asp-controller="Home" asp-action="Index">
                <svg aria-hidden="true"><use href="#i-dashboard"></use></svg> بازگشت به داشبورد
            </a>
            <button class="button secondary" type="button" onclick="history.back()">بازگشت به صفحه قبل</button>
        </div>
    </div>
</div>
