@model IEnumerable<VisitRegistry.Models.BlackListEntry>
@inject VisitRegistry.Services.PersianDateService PersianDate
@{ ViewData["Title"] = "بلک‌لیست"; }
<div class="page-head"><h1>فهرست ممنوع‌الورود</h1>@if(User.IsInRole("مدیر سامانه")){<a class="button" asp-action="Create">ثبت ممنوعیت</a>}</div>
<div class="card table-wrap"><table class="responsive-table"><thead><tr><th>شخص</th><th>شماره ملی</th><th>علت</th><th>شروع</th><th>پایان</th><th>وضعیت</th>@if(User.IsInRole("مدیر سامانه")){<th>عملیات</th>}</tr></thead><tbody>@foreach(var x in Model){<tr><td data-label="شخص">@x.Person?.FirstName @x.Person?.LastName</td><td data-label="شماره ملی">@x.Person?.NationalCode</td><td data-label="علت">@x.Reason</td><td data-label="شروع">@PersianDate.ToPersian(x.StartDate)</td><td data-label="پایان">@(x.EndDate.HasValue ? PersianDate.ToPersian(x.EndDate.Value) : "بدون پایان")</td><td data-label="وضعیت">@(x.IsActive ? "فعال" : "غیرفعال")</td>@if(User.IsInRole("مدیر سامانه")){<td class="actions" data-label="عملیات"><a class="button small secondary" asp-action="Edit" asp-route-id="@x.BlackListEntryId">ویرایش</a><form asp-action="Delete" asp-route-id="@x.BlackListEntryId" method="post" class="inline" onsubmit="return confirm('آیا از حذف این رکورد ممنوعیت مطمئن هستید؟');">@Html.AntiForgeryToken()<button type="submit" class="button small danger">حذف</button></form></td>}</tr>}</tbody></table></div>
