@model IEnumerable<VisitRegistry.Models.OrganizationalUnit>
@{ ViewData["Title"] = "واحدهای سازمانی"; }
<div class="page-head"><h1>واحدهای سازمانی</h1>@if(User.IsInRole("مدیر سامانه")){<a class="button" asp-action="Create">واحد جدید</a>}</div>
<form method="get" class="searchbar">
    <input name="search" value="@Context.Request.Query["search"]" placeholder="جستجو بر اساس عنوان، کد یا توضیحات واحد" />
    <button class="button secondary" type="submit">جستجو</button>
    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["search"]))
    {
        <a class="button secondary" asp-action="Index">پاک کردن</a>
    }
</form>
<div class="card table-wrap"><table class="responsive-table"><thead><tr><th>عنوان</th><th>کد</th><th>وضعیت</th><th>توضیحات</th>@if(User.IsInRole("مدیر سامانه")){<th>عملیات</th>}</tr></thead><tbody>@foreach(var u in Model){<tr><td data-label="عنوان">@u.Title</td><td data-label="کد">@u.Code</td><td data-label="وضعیت">@(u.IsActive ? "فعال" : "غیرفعال")</td><td data-label="توضیحات">@u.Description</td>@if(User.IsInRole("مدیر سامانه")){<td class="actions" data-label="عملیات"><a class="button small secondary" asp-action="Edit" asp-route-id="@u.OrganizationalUnitId">ویرایش</a><form asp-action="Delete" asp-route-id="@u.OrganizationalUnitId" method="post" class="inline" onsubmit="return confirm('آیا از حذف این واحد مطمئن هستید؟');">@Html.AntiForgeryToken()<button type="submit" class="button small danger">حذف</button></form></td>}</tr>} </tbody></table></div>
