@model IEnumerable<VisitRegistry.Models.OrganizationalUnit>
@{ ViewData["Title"] = "واحدهای سازمانی"; }
<div class="page-head">
    <div class="page-title">
        <span class="page-title-icon" aria-hidden="true"><svg><use href="#i-sitemap"></use></svg></span>
        <div>
            <h1>واحدهای سازمانی</h1>
            <p class="subtitle">فهرست واحدها و مراجعه‌کنندگان هر واحد</p>
        </div>
    </div>
    @if (User.IsInRole("مدیر سامانه"))
    {
        <a class="button" asp-action="Create"><svg aria-hidden="true"><use href="#i-plus"></use></svg> واحد جدید</a>
    }
</div>

@await Html.PartialAsync("_SearchBar", "جستجو بر اساس عنوان، کد یا توضیحات واحد")

<div class="card flush">
    <div class="table-toolbar">
        <span class="count js-row-count"></span>
        <div class="search-field table-search js-table-search">
            <svg class="search-icon" aria-hidden="true"><use href="#i-search"></use></svg>
            <input type="search" placeholder="فیلتر سریع در همین صفحه" aria-label="فیلتر سریع جدول" autocomplete="off" />
            <button type="button" class="clear-search" aria-label="پاک کردن فیلتر">
                <svg style="width:14px;height:14px" aria-hidden="true"><use href="#i-x"></use></svg>
            </button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="responsive-table units-table" data-table>
            <thead>
                <tr>
                    <th class="sortable">عنوان واحد</th>
                    <th>کد واحد</th>
                    <th>وضعیت</th>
                    <th class="wrap">توضیحات</th>
                    @if (User.IsInRole("مدیر سامانه"))
                    {
                        <th>عملیات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td data-label="عنوان واحد">@u.Title</td>
                        <td data-label="کد واحد">@(string.IsNullOrWhiteSpace(u.Code) ? "—" : u.Code)</td>
                        <td data-label="وضعیت">
                            @if (u.IsActive)
                            {
                                <span class="badge success">فعال</span>
                            }
                            else
                            {
                                <span class="badge danger">غیرفعال</span>
                            }
                        </td>
                        <td class="wrap" data-label="توضیحات">@(string.IsNullOrWhiteSpace(u.Description) ? "—" : u.Description)</td>
                        @if (User.IsInRole("مدیر سامانه"))
                        {
                            <td class="actions" data-label="عملیات">
                                <a class="button small secondary" asp-action="Edit" asp-route-id="@u.OrganizationalUnitId">
                                    <svg aria-hidden="true"><use href="#i-edit"></use></svg> ویرایش
                                </a>
                                <form asp-action="Delete" asp-route-id="@u.OrganizationalUnitId" method="post" class="inline" data-confirm="آیا از حذف این واحد مطمئن هستید؟ افراد متعلق به این واحد دیگر قابل انتخاب نخواهند بود.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="button small soft-danger">
                                        <svg aria-hidden="true"><use href="#i-trash"></use></svg> حذف
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                <tr data-empty-row hidden>
                    <td colspan="5">
                        <partial name="_EmptyState" model="@("واحد سازمانی یافت نشد. عبارت جستجو را تغییر دهید یا واحد جدیدی ثبت کنید.")" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <partial name="_TablePager" />
</div>
