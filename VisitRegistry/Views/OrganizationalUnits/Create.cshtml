@model VisitRegistry.Models.OrganizationalUnit
@{ ViewData["Title"] = "ثبت واحد جدید"; }
<div class="page-head"><h1>ثبت واحد سازمانی</h1><a asp-action="Index">بازگشت</a></div>
<div class="card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div>
<label asp-for="Title"></label><input asp-for="Title" /><span asp-validation-for="Title" class="validation"></span>
<label asp-for="Code"></label><input asp-for="Code" />
<label asp-for="Description"></label><textarea asp-for="Description"></textarea>
<label class="check"><input asp-for="IsActive" /> فعال</label>
<button class="button" type="submit">ثبت واحد</button></form></div>
