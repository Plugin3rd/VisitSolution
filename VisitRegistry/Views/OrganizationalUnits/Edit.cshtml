@model VisitRegistry.Models.OrganizationalUnit
@using VisitRegistry.Models
@{ ViewData["Title"] = "ویرایش واحد سازمانی"; }
<div class="page-head">
    <div class="page-title">
        <span class="page-title-icon" aria-hidden="true"><svg><use href="#i-sitemap"></use></svg></span>
        <div>
            <h1>ویرایش واحد سازمانی</h1>
            <p class="subtitle">اصلاح اطلاعات واحد</p>
        </div>
    </div>
    <a asp-action="Index">بازگشت به فهرست</a>
</div>

<div class="card form-grid two">
    <div class="card-head">
        <h2>اطلاعات واحد</h2>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="OrganizationalUnitId" />
        <input type="hidden" asp-for="RecordVersion" />
        <div asp-validation-summary="All" class="validation validation-summary-errors"></div>

        <div class="span-2">
            <label asp-for="Title">عنوان واحد <span class="req">*</span></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="validation"></span>
        </div>

        <div>
            <label asp-for="Code">کد واحد</label>
            <input asp-for="Code" maxlength="50" />
        </div>

        <div>
            <label asp-for="UnitType">نوع واحد <span class="req">*</span></label>
            <select asp-for="UnitType" asp-items="Html.GetEnumSelectList<UnitType>()">
                <option value="">انتخاب کنید</option>
            </select>
            <span asp-validation-for="UnitType" class="validation"></span>
        </div>

        <div class="span-2">
            <label asp-for="Description">توضیحات</label>
            <textarea asp-for="Description" placeholder="توضیح کوتاهی درباره این واحد..."></textarea>
        </div>

        <div class="span-2">
            <label class="check"><input asp-for="IsActive" /> فعال باشد</label>
        </div>

        <div class="form-actions span-2">
            <button class="button" type="submit"><svg aria-hidden="true"><use href="#i-check"></use></svg> ذخیره تغییرات</button>
            <a class="button ghost" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
