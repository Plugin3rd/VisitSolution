@model VisitRegistry.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "ورود";
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ورود - سامانه ثبت مراجعات</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-page">
<div class="login-card">
    <h1>سامانه ثبت مراجعات</h1>
    <p>ورود به سامانه</p>
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation"></div>
        <label asp-for="UserName"></label>
        <input asp-for="UserName" autocomplete="username" />
        <span asp-validation-for="UserName" class="validation"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="validation"></span>
        <label class="check"><input asp-for="RememberMe" /> مرا به خاطر بسپار</label>
        <button class="button full" type="submit">ورود به سامانه</button>
    </form>
</div>
</body>
</html>
